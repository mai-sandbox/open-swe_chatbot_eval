# Anthropic API Key for Claude model
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangGraph Platform API Configuration
LANGGRAPH_API_URL=https://api.langgraph.com
LANGGRAPH_API_KEY=your_langgraph_api_key_here

# Optional: Local LangGraph Server Configuration (for development)
# LANGGRAPH_API_URL=http://localhost:8123
# LANGGRAPH_API_KEY=your_local_api_key_here

# Remote Agent Configuration
# Add your deployed agent IDs here
RESEARCH_AGENT_ID=your_research_agent_id
ANALYSIS_AGENT_ID=your_analysis_agent_id
TASK_AGENT_ID=your_task_agent_id

# Optional: Additional Configuration
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=multi-agent-supervisor
